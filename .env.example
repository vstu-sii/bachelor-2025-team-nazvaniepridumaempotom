# ============================================
# LLM SERVICE (Ollama) - НЕ ТРЕБУЕТ КЛЮЧЕЙ!
# ============================================

# Модели Ollama (скачиваются автоматически)
OLLAMA_MODELS=llava:latest,llama3.2:1b

# Настройки Ollama
OLLAMA_HOST=0.0.0.0
OLLAMA_NUM_PARALLEL=2
OLLAMA_KEEP_ALIVE=24h

# ============================================
# BACKEND API
# ============================================

# База данных
DATABASE_URL=postgresql://app:app@db:5432/app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Настройки приложения
SECRET_KEY=dev-secret-key-change-in-production-12345
DEBUG=true
ENVIRONMENT=development

# Ссылки на сервисы
LLM_SERVICE_URL=http://llm-service:8001
FRONTEND_URL=http://localhost:3000

# ============================================
# LANGFUSE (ОПЦИОНАЛЬНО)
# ============================================

# Включение/отключение Langfuse
LANGFUSE_ENABLED=false

# Ключи Langfuse (нужны только если LANGFUSE_ENABLED=true)
# Получить можно на https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://langfuse:3000

# Секреты для Langfuse сервера (если запускаете локально)
LANGFUSE_SECRET=dev-secret-change-me
LANGFUSE_SALT=dev-salt-change-me
LANGFUSE_ENCRYPTION_KEY=dev-encryption-key-change-me

# ============================================
# JUPYTER
# ============================================

JUPYTER_TOKEN=dev123
JUPYTER_ENABLE_LAB=yes